# Public Firebase WEB app configuration, copied locally to .env.local.
# These values are bundled into the client. NEVER put Admin/service-account keys here.
# Live configuration targets the existing Spark project only; no Analytics needed.
# GitHub Pages: set the four required VITE_FIREBASE_* fields below as repository
# Actions variables (or secrets) with these exact names. .env.local is not deployed.
# See docs/implementation/PHASE_2_DEPLOYMENT_FIX.md for the production checklist.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=billora-pwa.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=billora-pwa
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_USE_EMULATORS=false
# Default false. npm run dev:legacy enables only the existing local app in DEV.
# This flag is ignored by production builds; keep pilot and legacy on separate ports.
VITE_ENABLE_LEGACY_DEV=false

# To use ONLY local emulators instead, replace the configuration above with:
# VITE_FIREBASE_API_KEY=demo-emulator-api-key
# VITE_FIREBASE_AUTH_DOMAIN=localhost
# VITE_FIREBASE_PROJECT_ID=demo-billora-phase2
# VITE_FIREBASE_APP_ID=demo-emulator-app
# VITE_FIREBASE_USE_EMULATORS=true
